{
  "name": "readymade-ship-workspace",
  "displayName": "Readymade Ship Workspace",
  "description": "Urbit source, drafts, Pataphor receipts and terminals in a real editor workbench.",
  "version": "0.2.0",
  "publisher": "pataphor",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.143.0",
    "node": ">=22"
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:readymade.welcome",
    "onWebviewPanel:readymade.planetSetup"
  ],
  "enabledApiProposals": [
    "browser"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "languages": [{"id": "hoon", "aliases": ["Hoon", "hoon"], "extensions": [".hoon", ".hook"], "filenamePatterns": ["**/hoon"], "configuration": "./platform/hoon-language.json"}],
    "grammars": [{"language": "hoon", "scopeName": "source.hoon", "path": "./platform/hoon.tmLanguage"}],
    "configurationDefaults": {
      "workbench.browser.dataStorage": "ephemeral",
      "workbench.startupEditor": "none"
    },
    "commands": [
      {"command": "readymade.home", "title": "Readymade: Home", "icon": "$(home)"},
      {"command": "readymade.getUrbit", "title": "Readymade: Get an Urbit"},
      {"command": "readymade.installBackend", "title": "Readymade: Install Pataphor on This Ship"},
      {"command": "readymade.startPlanet", "title": "Readymade: Start a Planet from a Keyfile"},
      {"command": "readymade.inspectWorkspaceResult", "title": "Readymade: Inspect Files and Checks"},
      {"command": "readymade.inviteCollaborator", "title": "Readymade: Invite Collaborator"},
      {"command": "readymade.joinProject", "title": "Readymade: Join Project"},
      {"command": "readymade.switchShip", "title": "Readymade: Switch Ship…"},
      {"command": "readymade.inviteAndCopyLink", "title": "Readymade: Invite Collaborator and Copy Join Link"},
      {"command": "readymade.doctor", "title": "Readymade: Ship Doctor"},
      {"command": "readymade.ownerInbox", "title": "Readymade: Check What Is Waiting on Me"},
      {"command": "readymade.projectActivity", "title": "Readymade: Project Activity"},
      {"command": "readymade.followBackendUpdates", "title": "Readymade: Follow Pataphor Updates"},
      {"command": "readymade.checkProjectInvitation", "title": "Readymade: Check Invitation Result"},
      {"command": "readymade.leaveProject", "title": "Readymade: Leave Project"},
      {"command": "readymade.removeCollaborationService", "title": "Readymade: Remove Collaboration Service"},
      {"command": "readymade.copyProjectJoinLink", "title": "Readymade: Copy Project Join Link"},
      {"command": "readymade.projectMembers", "title": "Readymade: Project Members"},
      {"command": "readymade.projectInvitations", "title": "Readymade: Pending Project Invitations"},
      {"command": "readymade.projectHistory", "title": "Readymade: Project History"},
      {"command": "readymade.nextProjectMembers", "title": "Readymade: Next Membership Page"},
      {"command": "readymade.closeProjectInvitation", "title": "Readymade: Close Project Invitation"},
      {"command": "readymade.reconcileSharedDraft", "title": "Readymade: Reconcile Shared Draft"},
      {"command": "readymade.sendSharedSuggestion", "title": "Readymade: Send Shared Suggestion"},
      {"command": "readymade.checkSharedSuggestion", "title": "Readymade: Check Shared Suggestion Result"},
      {"command": "readymade.editSharedDraft", "title": "Readymade: Edit Shared Draft"},
      {"command": "readymade.openSharedDraft", "title": "Readymade: Open Shared Draft"},
      {"command": "readymade.compareSharedDraft", "title": "Readymade: Compare Shared Draft"},
      {"command": "readymade.openSharedProject", "title": "Readymade: Open Shared Project"},
      {"command": "readymade.resumeSharedProject", "title": "Readymade: Resume Shared Project"},
      {"command": "readymade.refreshSharedProject", "title": "Readymade: Refresh Shared Project"},
      {"command": "readymade.checkSharedProject", "title": "Readymade: Check Shared Project"},
      {"command": "readymade.refreshSharedActivity", "title": "Readymade: Refresh Shared Project Activity"},
      {"command": "readymade.refreshSharedSessions", "title": "Readymade: Refresh Shared Sessions"},
      {"command": "readymade.openSharedActivityFile", "title": "Readymade: Open Shared Collaborator File"},
      {"command": "readymade.openSharedSource", "title": "Readymade: Open Shared File"},
      {
        "command": "readymade.lattice",
        "title": "Readymade: Open Lattice",
        "icon": "$(notebook)"
      },
      {
        "command": "readymade.checkSetup",
        "title": "Readymade: Check Setup",
        "icon": "$(checklist)"
      },
      {
        "command": "readymade.groups",
        "title": "Readymade: Open Tlon Groups",
        "icon": "$(organization)"
      },
      {
        "command": "readymade.landscape",
        "title": "Readymade: Open Landscape",
        "icon": "$(home)"
      },
      {
        "command": "readymade.selectProject",
        "title": "Readymade: Choose Project"
      },
      {"command": "readymade.importSharedMessage", "title": "Readymade: Import Shared Message"},
      {"command": "readymade.checkSharedMessageImport", "title": "Readymade: Check Shared Message Import"},
      {
        "command": "readymade.workspaceRequests",
        "title": "Readymade: Project Requests"
      },
      {
        "command": "readymade.connect",
        "title": "Readymade: Connect to Ship",
        "icon": "$(plug)"
      },
      {
        "command": "readymade.refresh",
        "title": "Readymade: Refresh Ship Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "readymade.selectSession",
        "title": "Readymade: Observe Coding Session"
      },
      {
        "command": "readymade.openSource",
        "title": "Readymade: Open Retained Ship File"
      },
      {
        "command": "readymade.readFile",
        "title": "Readymade: Read Ship File"
      },
      {
        "command": "readymade.readNextPage",
        "title": "Readymade: Read Next Ship File Page"
      },
      { "command": "readymade.browseFiles", "title": "Readymade: Browse Ship Files" },
      { "command": "readymade.refreshFiles", "title": "Readymade: Refresh File Listing" },
      { "command": "readymade.moreFiles", "title": "Readymade: Load More Ship Files" },
      { "command": "readymade.checks", "title": "Readymade: Observe Native Checks" },
      { "command": "readymade.showCheck", "title": "Readymade: Inspect Check Evidence" },
      { "command": "readymade.runExpression", "title": "Readymade: Run Expression on Selected Ship Source", "icon": "$(play)" },
      { "command": "readymade.showEvaluation", "title": "Readymade: Show Evaluation Result" },
      { "command": "readymade.observeEvaluation", "title": "Readymade: Observe Evaluation Result" },
      { "command": "readymade.savedChecks", "title": "Readymade: Open Saved Check Report" },
      { "command": "readymade.reviewCode", "title": "Readymade: Observe Code Candidates" },
      { "command": "readymade.showCandidate", "title": "Readymade: Inspect Code Candidate" },
      { "command": "readymade.savedCandidates", "title": "Readymade: Open Saved Candidate Review" },
      { "command": "readymade.startCodeReview", "title": "Readymade: Start Governed Code Review" },
      { "command": "readymade.applyCandidate", "title": "Readymade: Apply Reviewed Change" },
      { "command": "readymade.checkAppliedCandidate", "title": "Readymade: Check Applied Change" },
      { "command": "readymade.recoverCodeReview", "title": "Readymade: Observe Retained Code Review" },
      { "command": "readymade.reviewPolicy", "title": "Readymade: Observe Project Reviewer" },
      { "command": "readymade.shareActivity", "title": "Readymade: Share Activity" },
      { "command": "readymade.stopActivity", "title": "Readymade: Stop Sharing Activity" },
      { "command": "readymade.refreshActivity", "title": "Readymade: Refresh Project Activity" },
      { "command": "readymade.openActivityFile", "title": "Readymade: Open Collaborator File" },
      { "command": "readymade.copySharedProjectLink", "title": "Readymade: Copy Shared Project Link" },
      { "command": "readymade.copySharedFileLink", "title": "Readymade: Copy Shared File Link" },
      { "command": "readymade.projectSharing", "title": "Readymade: Project Sharing" },
      { "command": "readymade.grantProjectAccess", "title": "Readymade: Share Project Files" },
      { "command": "readymade.revokeProjectAccess", "title": "Readymade: Revoke Project Access" },
      { "command": "readymade.recoverProjectAccess", "title": "Readymade: Check Sharing Request" },
      { "command": "readymade.shareSession", "title": "Readymade: Share Agent Session" },
      { "command": "readymade.unshareSession", "title": "Readymade: Stop Sharing Agent Session" },
      { "command": "readymade.removeCollaborator", "title": "Readymade: Remove Collaborator from Project" },
      { "command": "readymade.projectSessionSharing", "title": "Readymade: Turn Session Sharing On or Off for This Project" },
      { "command": "readymade.configureReviewer", "title": "Readymade: Choose Project Reviewer" },
      { "command": "readymade.disableReviewer", "title": "Readymade: Disable Project Review" },
      { "command": "readymade.recoverReviewer", "title": "Readymade: Observe Retained Review Policy" },
      { "command": "readymade.reviewAnswer", "title": "Readymade: Review Answer Completion" },
      { "command": "readymade.acceptAnswer", "title": "Readymade: Accept Answer as Owner" },
      { "command": "readymade.recoverAnswer", "title": "Readymade: Observe Answer Decision" },
      {
        "command": "readymade.createDraft",
        "title": "Readymade: Create Draft from Ship File"
      },
      {
        "command": "readymade.openSavedDraft",
        "title": "Readymade: Open Saved Local Draft"
      },
      {
        "command": "readymade.prepareCandidate",
        "title": "Readymade: Prepare Candidate from Draft"
      },
      {
        "command": "readymade.reconcileDraft",
        "title": "Readymade: Reconcile Draft with Current Source"
      },
      {
        "command": "readymade.conversation",
        "title": "Readymade: Show Pataphor Workspace"
      },
      {
        "command": "readymade.request",
        "title": "Readymade: Send Pataphor Request"
      },
      {
        "command": "readymade.receipts",
        "title": "Readymade: Check Request Receipts"
      },
      {
        "command": "readymade.terminal",
        "title": "Readymade: Observe Ship Terminal"
      },
      {
        "command": "readymade.terminalControl",
        "title": "Readymade: Ship Terminal Control"
      },
      {
        "command": "readymade.glurff",
        "title": "Readymade: Open Glurff",
        "icon": "$(globe)"
      },
      {
        "command": "readymade.noltbook",
        "title": "Readymade: Calls and Notes (Noltbook)",
        "icon": "$(comment-discussion)"
      },
      {"command": "readymade.openDocument", "title": "Readymade: Open Shared Document"},
      {"command": "readymade.publishDocument", "title": "Readymade: Publish Shared Document"},
      {"command": "readymade.checkDocument", "title": "Readymade: Check Shared Document"},
      {"command": "readymade.reconcileDocument", "title": "Readymade: Reconcile Shared Document"},
      {"command": "readymade.compareDocument", "title": "Readymade: Compare Shared Document"},
      {"command": "readymade.openDocumentInNoltbook", "title": "Readymade: Open Document in Noltbook"},
      {"command": "readymade.documentHistory", "title": "Readymade: Shared Document History"},
      {"command": "readymade.restoreDocumentVersion", "title": "Readymade: Restore Document Version"},
      {
        "command": "readymade.calls",
        "title": "Readymade: Open Legacy Call Board"
      },
      {
        "command": "readymade.mediaObserve",
        "title": "Readymade: Check Media Tab",
        "icon": "$(info)"
      },
      {
        "command": "readymade.mediaReconnect",
        "title": "Readymade: Reconnect Media Tab",
        "icon": "$(refresh)"
      },
      {
        "command": "readymade.mediaClose",
        "title": "Readymade: Close Media Tab",
        "icon": "$(close)"
      },
      {
        "command": "readymade.mediaForget",
        "title": "Readymade: Disconnect Private Media"
      },
      {
        "command": "readymade.legacyCalls",
        "title": "Readymade: Show Existing Native Calls"
      },
      {
        "command": "readymade.returnCode",
        "title": "Readymade: Return to Code",
        "icon": "$(code)"
      },
      {
        "command": "readymade.changes",
        "title": "Readymade: Show Ship Changes",
        "icon": "$(diff)"
      },
      {
        "command": "readymade.reviewDraft",
        "title": "Readymade: Review Draft Changes"
      },
      {
        "command": "readymade.reviewSubmitted",
        "title": "Readymade: Review Submitted Changes"
      }
    ],
    "views": {
      "readymade": [
        {
          "id": "readymade.workspace",
          "name": "Readymade",
          "visibility": "visible"
        }
      ]
    },
    "configuration": {
      "title": "Readymade",
      "properties": {
        "readymade.assistantPath": {"type": "string", "default": "", "description": "The command line on Home asks the coding assistant installed on this computer: Claude Code if it is found, otherwise Codex. To choose one yourself, give the full path of its claude or codex program here."},
        "readymade.connectOnStart": {
          "type": "boolean",
          "default": true,
          "description": "When Readymade opens, connect by itself: the ship you last used, or the only ship running on this Mac. Nothing is typed and nothing is asked. A hosted ship uses the login code saved in the Keychain."
        },
        "readymade.callNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show incoming Noltbook calls after connecting, even while its tab is closed. Opening a notification never joins automatically."
        },
        "readymade.origin": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Exact Urbit origin. Authentication uses the private saved-code store or VS Code secret storage."
        },
        "readymade.legacyMediaSocket": {
          "type": "string",
          "default": "",
          "description": "Optional existing native Readymade owner socket. Showing an existing call preserves its current media owner."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "readymade",
          "title": "Readymade",
          "icon": "platform/urbit.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [{"command": "readymade.runExpression", "when": "resourceScheme == urbit-source", "group": "navigation@4"}],
      "view/title": [
        {"command": "readymade.home", "when": "view == readymade.workspace", "group": "navigation@0"},
        {
          "command": "readymade.connect",
          "when": "view == readymade.workspace",
          "group": "connection"
        }
      ],
      "view/item/context": [
        {
          "command": "readymade.mediaObserve",
          "when": "view == readymade.workspace && viewItem == readymade.media",
          "group": "inline@1"
        },
        {
          "command": "readymade.mediaClose",
          "when": "view == readymade.workspace && viewItem == readymade.media",
          "group": "inline@2"
        },
        {
          "command": "readymade.mediaReconnect",
          "when": "view == readymade.workspace && viewItem == readymade.media",
          "group": "manage@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "lint": "eslint src tests platform packaging/*.cjs backend/install/*.cjs",
    "bundle:backend": "python3 backend/application/rebuild.py",
    "test": "npm run build && node --test dist/tests/*.test.js tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.144.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DashusNavnul/readymade.git"
  },
  "homepage": "https://github.com/DashusNavnul/readymade#readme",
  "bugs": {
    "url": "https://github.com/DashusNavnul/readymade/issues"
  }
}
