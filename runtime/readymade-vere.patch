+/* Equal values with sharing on opposite alternating levels. */
+static u3_noun
+_test_crossed_tree(c3_w dep_w, c3_o sha_o)
+{
+  if ( !dep_w ) return u3nc(42, 0);
+
+  u3_noun a = _test_crossed_tree(dep_w - 1, c3n == sha_o ? c3y : c3n);
+  u3_noun b = (c3y == sha_o)
+            ? u3k(a)
+            : _test_crossed_tree(dep_w - 1, c3y);
+  return u3nc(a, b);
+}
+
+static c3_i
+_test_crossed_equality(void)
+{
+  //  Home nouns cannot be unified from a junior road. These comparisons
+  //  cross the fallback threshold while keeping the actual graphs small.
+  //
+  for ( c3_w dep_w = 0; dep_w < 3; dep_w++ ) {
+    u3_noun a = _test_crossed_tree(16, c3n);
+    u3_noun b = _test_crossed_tree(16, c3y);
+    c3_i ret_i = 1;
+
+    for ( c3_w i_w = 0; i_w < dep_w; i_w++ ) u3m_hate(0);
+
+    u3_post cap_p = u3R->cap_p;
+    for ( c3_w i_w = 0; i_w < 3; i_w++ ) {
+      if ( c3y != u3r_sing(a, b) || cap_p != u3R->cap_p ) ret_i = 0;
+    }
+    if ( dep_w && u3h(a) == u3h(b) ) ret_i = 0;
+
+    //  Equal large heads must not hide a later unequal tail. A failed
+    //  comparison must discard its classes before the next comparison.
+    //
+    u3_noun lef = u3nc(u3k(a), 0);
+    u3_noun rit = u3nc(u3k(b), 1);
+    if ( c3n != u3r_sing(lef, rit) || cap_p != u3R->cap_p ) ret_i = 0;
+    if ( c3n != u3r_sing(rit, lef) || cap_p != u3R->cap_p ) ret_i = 0;
+    if ( c3y != u3r_sing(a, b) || cap_p != u3R->cap_p ) ret_i = 0;
+    u3z(lef); u3z(rit);
+
+    for ( c3_w i_w = 0; i_w < dep_w; i_w++ ) u3m_love(0);
+    u3z(a); u3z(b);
+
+    if ( !ret_i ) {
+      fprintf(stderr, "test: crossed equality: road depth %u failed\r\n", dep_w);
+      return 0;
+    }
+  }
+
+  return 1;
+}
+
+/* Saturate comparison bookkeeping with distinct equal list nodes on senior
+** roads in a 64 MiB arena. Equality must not require an unbounded table.
+*/
+static c3_i
+_test_large_equality(void)
+{
+  u3_noun a = 0, b = 0, bad = 1;
+  for ( c3_w i_w = 0; i_w < 600000; i_w++ ) {
+    a = u3nc(i_w, a);
+    b = u3nc(i_w, b);
+    bad = u3nc(i_w, bad);
+  }
+  u3m_hate(0);
+  u3_post cap_p = u3R->cap_p;
+  c3_i ret_i = 1;
+  for ( c3_w i_w = 0; i_w < 3; i_w++ ) {
+    if ( c3y != u3r_sing(a, b) || c3y != u3r_sing(b, a) ||
+         c3n != u3r_sing(a, bad) || c3n != u3r_sing(bad, b) ||
+         cap_p != u3R->cap_p ) ret_i = 0;
+  }
+  //  Fill the comparison table while checking the equal heads, then meet
+  //  an unequal tail. Saturation must not turn a later difference into yes.
+  //
+  u3_noun lef = u3nc(u3k(a), 0);
+  u3_noun rit = u3nc(u3k(b), 1);
+  if ( c3n != u3r_sing(lef, rit) || c3n != u3r_sing(rit, lef) ||
+       cap_p != u3R->cap_p ) ret_i = 0;
+  u3z(lef); u3z(rit);
+  if ( u3t(a) == u3t(b) ) ret_i = 0;
+  u3m_love(0);
+  u3z(a); u3z(b); u3z(bad);
+  if ( !ret_i ) fprintf(stderr, "test: large equality failed\r\n");
+  return ret_i;
+}
+
 static c3_i
 _test_equality(void)
 {
@@ -140,6 +229,14 @@ _test_equality(void)
     ret_i = 0;
   }
 
+  if ( !_test_large_equality() ) {
+    ret_i = 0;
+  }
+
+  if ( !_test_crossed_equality() ) {
+    ret_i = 0;
+  }
+
   return ret_i;
 }
 
