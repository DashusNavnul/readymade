+  // This is an in-process reload, not exec: restore the writable loom that
+  // a fresh process supplies before no-demand read() copies image bytes.
+  // Keep the guard protected; u3e_live restores snapshot page protections.
+  CHECK(c3y == u3e_yolo());
+  // Reload the actual saved mapping; the noun's loom offset must survive.
+  CHECK(c3n == u3e_live(c3n, dir));
+  CHECK(hash == u3r_mug(live));
+  _strings(live, "snapshot-live", "unchanged");
+  CHECK(u3r_met(3, large) == atom_bytes);
+  u3r_bytes(0, atom_bytes, payload, large);
+  for (c3_w i = 0; i < atom_bytes; i++) CHECK(payload[i] == 0x7b);
+  free(payload);
+  _guard();
+  u3e_stop();
+  CHECK(unlink(image) == 0);
+  CHECK(rmdir(chk) == 0 && rmdir(urb) == 0 && rmdir(dir) == 0);
+}
+
+static void _snapshot_no_demand(void) {
+  u3C.wag_w |= u3o_no_demand;
+  _snapshot();
+}
+
+static u3_noun _road_leaf(u3_noun arg) {
+  CHECK(c3y == u3a_is_north(u3R));
+  u3_noun live = u3nc(u3i_string("inner-north"), u3i_string("retained"));
+  u3_post low, high;
+  u3m_water(&low, &high);
+  u3e_toss(low, high);
+  _strings(live, "inner-north", "retained");
+  u3z(arg);
+  return live;
+}
+
+static u3_noun _road_outer(u3_noun arg) {
+  CHECK(c3y == u3a_is_south(u3R));
+  u3_noun live = u3nc(u3i_string("inner-south"), u3i_string("retained"));
+  for (unsigned n = 0; n < 3; n++) {
+    // u3m_soft is a home-road boundary. Nested roads use its lower-level
+    // hate/love pair, which preserves the parent's cap and copies the result.
+    u3m_hate(1 << 18);
+    u3_noun result = _road_leaf(u3_nul);
+    result = u3m_love(result);
+    CHECK(c3y == u3a_is_south(u3R));
+    _strings(result, "inner-north", "retained");
+    _strings(live, "inner-south", "retained");
+    u3z(result);
+    u3_post low, high;
+    u3m_water(&low, &high);
+    u3e_toss(low, high);
+    _strings(live, "inner-south", "retained");
+  }
+  u3z(arg);
+  return live;
+}
+
+static void _roads(void) {
+  _setup();
+  u3_noun live = u3nc(u3i_string("home-north"), u3i_string("retained"));
+  for (unsigned n = 0; n < 3; n++) {
+    u3_noun result = u3m_soft(0, _road_outer, u3_nul);
+    CHECK(c3y == u3du(result) && u3h(result) == 0);
+    _strings(u3t(result), "inner-south", "retained");
+    _strings(live, "home-north", "retained");
+    u3z(result);
+    _guard();
+  }
+  u3z(live);
+}
+
+int main(void) {
+  void (*cases[])(void) = {
+    _bounds, _file_gap, _repeated, _snapshot, _snapshot_no_demand, _roads
+  };
+  for (size_t i = 0; i < sizeof cases / sizeof cases[0]; i++) {
+    pid_t pid = fork();
+    CHECK(pid >= 0);
+    if (!pid) { cases[i](); _exit(0); }
+    int status;
+    CHECK(waitpid(pid, &status, 0) == pid);
+    CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  }
+  fprintf(stderr, "toss-test: all cases passed\n");
+  return 0;
+}
