+static void _file_gap(void) {
+  _setup();
+  _free_gap(160, 3);
+  char path[] = "/tmp/vere-toss-file-XXXXXX";
+  int fd = mkstemp(path);
+  CHECK(fd >= 0);
+  CHECK(unlink(path) == 0);
+  unsigned char* bytes = malloc(PAGE_BYTES * 3);
+  CHECK(bytes != NULL);
+  memset(bytes, 0x6d, PAGE_BYTES * 3);
+  CHECK(write(fd, bytes, PAGE_BYTES * 3) == (ssize_t)(PAGE_BYTES * 3));
+  void* gap = _page(160);
+  CHECK(gap == mmap(gap, PAGE_BYTES * 3, PROT_READ,
+                    MAP_FIXED | MAP_PRIVATE, fd, 0));
+  for (c3_w p = 160; p < 163; p++) _clean(p);
+  u3e_toss(160 * PAGE_WORDS, 163 * PAGE_WORDS);
+#ifdef __APPLE__
+  for (c3_w p = 160; p < 163; p++) {
+    CHECK(*(c3_w*)_page(p) == 0 && _dirty(p));
+    memset(_page(p), 0x81, PAGE_BYTES); // regrowth must be writable
+  }
+#endif
+  CHECK(pread(fd, bytes, PAGE_BYTES * 3, 0) == (ssize_t)(PAGE_BYTES * 3));
+  for (size_t i = 0; i < PAGE_BYTES * 3; i++) CHECK(bytes[i] == 0x6d);
+  close(fd); free(bytes);
+  _guard();
+}
+
+#ifdef __APPLE__
+static task_vm_info_data_t _memory(void) {
+  task_vm_info_data_t info;
+  mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+  CHECK(KERN_SUCCESS == task_info(mach_task_self(), TASK_VM_INFO,
+                                  (task_info_t)&info, &count));
+  return info;
+}
+#endif
+static void _repeated(void) {
+  _setup();
+  const c3_w first = 128, pages = 1536; // 24 MiB; below midpoint guard
+#ifdef U3_GUARD_PAGE
+  CHECK(first + pages < u3P.gar_w);
+#endif
+  u3_noun live = u3nc(u3i_string("live-north"), u3i_string("live-south"));
+  c3_w hash = u3r_mug(live);
+  _free_gap(first, pages);
+  for (unsigned n = 0; n < 3; n++) {
+    memset(_page(first), 0x51 + n, pages * PAGE_BYTES);
+#ifdef __APPLE__
+    task_vm_info_data_t before = _memory();
+#endif
+    u3e_toss(first * PAGE_WORDS, (first + pages) * PAGE_WORDS);
+    CHECK(hash == u3r_mug(live));
+    _strings(live, "live-north", "live-south");
+#ifdef __APPLE__
+    task_vm_info_data_t after = _memory();
+    fprintf(stderr, "toss cycle %u footprint %llu -> %llu resident %llu -> %llu\n",
+      n, (unsigned long long)before.phys_footprint,
+      (unsigned long long)after.phys_footprint,
+      (unsigned long long)before.resident_size,
+      (unsigned long long)after.resident_size);
+    CHECK(before.phys_footprint > after.phys_footprint + pages * PAGE_BYTES / 2);
+    CHECK(before.resident_size > after.resident_size + pages * PAGE_BYTES / 2);
+#endif
+    _guard();
+  }
+  u3z(live);
+}
+
+static void _snapshot(void) {
