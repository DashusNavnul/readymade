+/// Real loom mappings: dead-page discard must preserve live data and tracking.
+#include "noun.h"
+#include "events.h"
+#include "options.h"
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#endif
+
+#define PAGE_WORDS ((c3_w)1 << u3a_page)
+#define PAGE_BYTES ((size_t)PAGE_WORDS * sizeof(c3_w))
+#define CHECK(x) do { if (!(x)) { \
+  fprintf(stderr, "toss-test:%d: %s\n", __LINE__, #x); exit(1); \
+} } while (0)
+
+static void* _page(c3_w p) { return (void*)(u3_Loom + p * PAGE_WORDS); }
+static void _setup(void) {
+  u3m_init(1 << 26); // bytes: 64 MiB virtual loom, at most 24 MiB touched
+  u3C.wag_w &= ~u3o_swap;
+  u3e_init();
+  u3m_pave(c3y);
+}
+static void _free_gap(c3_w first, c3_w count) {
+  u3_post low, high;
+  u3m_water(&low, &high);
+  CHECK(low <= first * PAGE_WORDS);
+  CHECK((first + count) * PAGE_WORDS <= high);
+}
+static void _strings(u3_noun live, const char* head, const char* tail) {
+  CHECK(c3y == u3du(live));
+  CHECK(c3y == u3ud(u3h(live)) && c3y == u3ud(u3t(live)));
+  char* h = u3r_string(u3h(live));
+  char* t = u3r_string(u3t(live));
+  CHECK(strcmp(h, head) == 0 && strcmp(t, tail) == 0);
+  free(h); free(t);
+}
+static int _dirty(c3_w p) {
+  return !!(u3P.dit_w[p >> 5] & ((c3_w)1 << (p & 31)));
+}
+static void _clean(c3_w p) {
+  u3P.dit_w[p >> 5] &= ~((c3_w)1 << (p & 31));
+}
+static void _guard(void) {
+#if defined(__APPLE__) && defined(U3_GUARD_PAGE)
+  mach_vm_address_t address = (mach_vm_address_t)_page(u3P.gar_w);
+  mach_vm_size_t size = 0;
+  vm_region_basic_info_data_64_t info;
+  mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+  mach_port_t object = MACH_PORT_NULL;
+  CHECK(KERN_SUCCESS == mach_vm_region(mach_task_self(), &address, &size,
+    VM_REGION_BASIC_INFO_64, (vm_region_info_t)&info, &count, &object));
+  CHECK(address <= (mach_vm_address_t)_page(u3P.gar_w));
+  CHECK(address + size > (mach_vm_address_t)_page(u3P.gar_w));
+  CHECK(info.protection == VM_PROT_NONE);
+  if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), object);
+#endif
+}
+
+static void _bounds(void) {
+  _setup();
+  _free_gap(128, 5);
+  c3_w* a = _page(128);
+  c3_w* b = _page(132);
+  memset(a, 0xa5, 5 * PAGE_BYTES);
+  _clean(129); _clean(130); _clean(131);
+  u3e_toss(128 * PAGE_WORDS + 1, 132 * PAGE_WORDS + PAGE_WORDS - 1);
+  CHECK(a[0] == 0xa5a5a5a5);
+  CHECK(a[PAGE_WORDS - 1] == 0xa5a5a5a5);
+  CHECK(b[0] == 0xa5a5a5a5);
+  CHECK(b[PAGE_WORDS - 1] == 0xa5a5a5a5);
+#ifdef __APPLE__
+  for (c3_w p = 129; p <= 131; p++) {
+    c3_w* words = _page(p);
+    for (c3_w j = 0; j < PAGE_WORDS; j++) CHECK(words[j] == 0);
+    CHECK(_dirty(p));
+  }
+#endif
+  c3_w bitmap = u3P.dit_w[128 >> 5];
+  u3e_toss(133 * PAGE_WORDS, 128 * PAGE_WORDS);
+  u3e_toss(128 * PAGE_WORDS, 128 * PAGE_WORDS);
+  u3e_toss(128 * PAGE_WORDS + 2, 128 * PAGE_WORDS + 3);
+  u3e_toss(UINT32_MAX, UINT32_MAX);
+  u3e_toss(0, UINT32_MAX);
+  u3e_toss(u3C.wor_i + 1, u3C.wor_i + 2);
+  CHECK(a[0] == 0xa5a5a5a5 && b[0] == 0xa5a5a5a5);
+  CHECK(bitmap == u3P.dit_w[128 >> 5]);
