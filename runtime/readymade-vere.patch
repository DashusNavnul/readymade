diff --git a/pkg/noun/lazy_bench.c b/pkg/noun/lazy_bench.c
new file mode 100644
index 0000000000..d79b8d98ed
--- /dev/null
+++ b/pkg/noun/lazy_bench.c
@@ -0,0 +1,47 @@
+/// @file  lazy_bench.c: time u3h_free() of a large table (the _cr_sing_cape pattern)
+
+#include "noun.h"
+#include "events.h"
+
+static c3_w N_w;
+
+static u3_noun
+_build_free(u3_noun arg)
+{
+  u3p(u3h_root) har_p = u3h_new();
+  struct timespec a, b, c;
+  clock_gettime(CLOCK_MONOTONIC, &a);
+
+  for ( c3_w i_w = 0; i_w < N_w; i_w++ ) {
+    //  keys like _cr_sing_cape_keep(): a cell of two offsets
+    u3_noun key = u3nc(i_w * 7 + 1, i_w * 13 + 5);
+    u3h_put(har_p, key, c3y);
+    u3z(key);
+  }
+  clock_gettime(CLOCK_MONOTONIC, &b);
+  u3h_free(har_p);
+  clock_gettime(CLOCK_MONOTONIC, &c);
+
+  fprintf(stderr, "%s road: N=%u  build %.2f s  free %.2f s\r\n",
+          (u3R == &u3H->rod_u) ? "home" : "inner", N_w,
+          (b.tv_sec - a.tv_sec) + (b.tv_nsec - a.tv_nsec) / 1e9,
+          (c.tv_sec - b.tv_sec) + (c.tv_nsec - b.tv_nsec) / 1e9);
+  u3z(arg);
+  return u3_nul;
+}
+
+int
+main(int argc, char* argv[])
+{
+  const c3_c* n_c = getenv("LAZY_N");
+  N_w = n_c ? (c3_w)atoi(n_c) : 1000000;
+
+  u3m_init((size_t)1 << 32);
+  u3e_init();
+  u3m_pave(c3y);
+
+  u3z(u3m_soft(0, _build_free, u3_nul));   //  inner road, as in the deploy
+  u3z(_build_free(u3_nul));                 //  home road
+  fprintf(stderr, "lazy bench: ok\r\n");
+  return 0;
+}
