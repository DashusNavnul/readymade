+  memset(_page(guard + 1), 0x72, PAGE_BYTES);
+  u3e_toss((guard - 1) * PAGE_WORDS, (guard + 2) * PAGE_WORDS);
+  CHECK(guard == u3P.gar_w && _dirty(guard));
+  _guard();
+#ifdef __APPLE__
+  CHECK(*(c3_w*)_page(guard - 1) == 0);
+  CHECK(*(c3_w*)_page(guard + 1) == 0);
+#endif
+#endif
+}
