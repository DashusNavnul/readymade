index 0000000000..9492a0bd1e
--- /dev/null
+++ b/pkg/noun/oom_tests.c
@@ -0,0 +1,107 @@
+/// Allocation failure must preserve the road and return a recoverable error.
+#include "noun.h"
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define CHECK(x) do { if (!(x)) { \
+  fprintf(stderr, "oom-test:%d: %s\n", __LINE__, #x); exit(1); \
+} } while (0)
+
+static c3_w _mode_w;
+
+static u3_noun
+_allocate_too_much(u3_noun depth, u3_noun unused)
+{
+  if ( depth ) {
+    return u3m_soft_run(u3_nul, _allocate_too_much, depth - 1, u3_nul);
+  }
+
+  c3_w gap_w = u3a_open(u3R);
+  c3_w len_w;
+  switch ( _mode_w ) {
+    case 0: len_w = gap_w + (1U << u3a_page); break;
+    case 1: len_w = gap_w + (1U << 26); break;
+    case 2: {
+      // Leave one page, then request enough to grow the page directory.
+      // Payload is never touched; only a few KiB of metadata are written.
+      c3_w fit_w = (gap_w & ~((1U << u3a_page) - 1)) - (1U << u3a_page);
+      u3a_walloc(fit_w);
+      CHECK(u3a_open(u3R) <= (2U << u3a_page));
+      len_w = u3R->hep.siz_w << u3a_page;
+    } break;
+    default: len_w = UINT32_MAX; break;
+  }
+  fprintf(stderr, "oom-test: mode %u %s (request=%u, gap=%u words)\n",
+          _mode_w, (c3y == u3a_is_north(u3R)) ? "north" : "south",
+          len_w, u3a_open(u3R));
+  u3a_walloc(len_w);
+  CHECK(!"oversized allocation succeeded");
+  return u3_nul;
+}
+
+static u3_noun
+_nested_failure(u3_noun depth)
+{
+  return u3m_soft_run(u3_nul, _allocate_too_much, depth, u3_nul);
+}
+
+static u3_noun
+_success(u3_noun unused)
+{
+  return u3nc(u3i_string("still alive"), 42);
+}
+
+static void
+_recover(c3_w depth_w)
+{
+  // A 64 MiB virtual loom; no ship, checkpoint, network or large payload.
+  u3m_boot_lite(1U << 26);
+  struct rlimit lim_u = {0, 0};
+  CHECK(0 == setrlimit(RLIMIT_CORE, &lim_u));
+  u3_noun live = u3i_string("parent data survives");
+  c3_w mug_w = u3r_mug(live);
+  u3_post cap_p = u3R->cap_p;
+
+  for ( c3_w i_w = 0; i_w < 2; i_w++ ) {
+    u3_noun err = u3m_soft(0, _nested_failure, depth_w);
+    CHECK(c3y == u3du(err) && c3__meme == u3h(err));
+    CHECK(u3R == &u3H->rod_u && cap_p == u3R->cap_p);
+    CHECK(mug_w == u3r_mug(live));
+    CHECK(c3y == u3r_sing_c("parent data survives", live));
+    u3z(err);
+
+    u3_noun pro = u3m_soft(0, _success, u3_nul);
+    CHECK(c3y == u3du(pro) && 0 == u3h(pro));
+    CHECK(c3y == u3du(u3t(pro)) && 42 == u3t(u3t(pro)));
+    CHECK(c3y == u3r_sing_c("still alive", u3h(u3t(pro))));
+    u3z(pro);
+  }
+  u3z(live);
+}
+
+int
+main(void)
+{
+  c3_i ret_i = 0;
+  for ( c3_w case_w = 0; case_w < 8; case_w++ ) {
+    c3_w depth_w = case_w & 1;
+    pid_t pid_i = fork();
+    CHECK(pid_i >= 0);
+    if ( !pid_i ) {
+      _mode_w = case_w >> 1;
+      struct rlimit lim_u = {5, 5};
+      CHECK(0 == setrlimit(RLIMIT_CPU, &lim_u));
+      _recover(depth_w);
+      _exit(0);
+    }
+    int status_i;
+    CHECK(pid_i == waitpid(pid_i, &status_i, 0));
+    if ( !WIFEXITED(status_i) || WEXITSTATUS(status_i) ) {
+      fprintf(stderr, "oom-test: case %u failed (status=%d)\n", case_w, status_i);
+      ret_i = 1;
+    }
+  }
+  if ( !ret_i ) fprintf(stderr, "oom-test: all cases passed\n");
+  return ret_i;
+}
