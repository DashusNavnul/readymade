::  Fresh-install structure check, not whole-state preservation or media proof.
=/  parameters  !<([expected=@p target=@tas revision=@ud root=@ux existing-apps=@ud] arg)
=/  m  (strand ,vase)
;<  b=bowl  bind:m  get-bowl
?>  &(=(expected.parameters our.b) =(our.b src.b))
=/  ship=@ta  (scot %p our.b)
=/  date=@ta  (scot %da now.b)
=/  revision=@ta  (scot %ud revision.parameters)
=/  ds=cone:clay  .^(cone:clay %cx /[ship]//[date]/domes)
=/  app=dome:clay  (~(got by ds) [our.b target.parameters])
?>  &(=(revision.parameters let.app) =(%live liv.app) =(~ wic.app) =(~ ren.app))
?>  =(root.parameters (~(got by hit.app) revision.parameters))
=/  d=dome:clay  (~(got by ds) [our.b %noltbook-data])
?>  &(=(1 let.d) =(%dead liv.d) =(~ wic.d) =(~ ren.d))
=/  seeds=(list path)  ~[/mar/noun/hoon /mar/hoon/hoon /mar/txt/hoon /mar/kelvin/hoon /mar/mime/hoon /sys/kelvin]
?>  =((silt seeds) (silt .^((list path) %ct /[ship]/noltbook-data/1)))
?>  (levy seeds |=(p=path =(.^(* %cx (weld /[ship]/noltbook-data/1 p)) .^(* %cx (weld /[ship]/[target.parameters]/[revision] p)))))
=/  perms  .^([dict:clay dict:clay] %cp /[ship]/noltbook-data/[date])
?>  =(perms [[/ %white ~ ~] [/ %white ~ ~]])
?>  .^(? %gu /[ship]/noltbook/[date]/$)
?>  .^(? %gu /[ship]/noltbook-calls/[date]/$)
?>  =(target.parameters .^(@tas %gd /[ship]/noltbook/[date]/$))
?>  =(target.parameters .^(@tas %gd /[ship]/noltbook-calls/[date]/$))
=/  names=(map @tas @)  .^((map @tas @) %gf ship %$ date /$)
?>  =((add 2 existing-apps.parameters) ~(wyt by names))
?>  (levy ~(tap by names) |=([name=@tas nonce=@] .^(? %gu ship name date /$)))
(pure:m !>([%readymade-noltbook-post-install-v2 our.b now.b target.parameters let.app root.parameters let.d (lent seeds) perms ~(wyt by names)]))
